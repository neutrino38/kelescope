# Configuration du service kelescope (sourcé par systemd, EnvironmentFile).
# Fichier root:kelixip, mode 0640 : lisible par le service, pas par les autres comptes.

PHX_SERVER=true

# Identité du nœud Erlang de kelescope, sur le même réseau et dans le même
# mode (noms longs) que le nœud kelixip surveillé. EPMD (port 4369) et la
# plage de ports de distribution Erlang doivent être ouverts vers kelixip.
RELEASE_NODE=kelescope@CHANGE-ME.example.org
# Sans cette ligne, une release Elixir demarre en noms courts et net_kernel
# echoue avec nodistribution : le service ne demarre pas du tout.
RELEASE_DISTRIBUTION=name
# RELEASE_COOKIE=

# Nœud kelixip à surveiller et cookie Erlang partagé avec lui (le même que kelictl).
KELIXIP_NODE=kelixip@CHANGE-ME.example.org
KELIXIP_COOKIE=CHANGE-ME

# Nom d'hôte public utilisé pour générer les URLs et le paramètre secret de session.
PHX_HOST=CHANGE-ME.example.org
SECRET_KEY_BASE=CHANGE-ME

# Port HTTPS d'écoute et certificat servi. Voir docs/maintenance/paquet-rpm.md.
KELESCOPE_HTTPS_PORT=8443
KELESCOPE_SSL_CERTFILE=/etc/kelescope/tls/kelescope.crt
KELESCOPE_SSL_KEYFILE=/etc/kelescope/tls/kelescope.key

# Comptes administrateurs, autorité de certification et certificats clients
# (ADR-004). Sauvegardez ce répertoire entier : il contient tous les accès.
KELESCOPE_AUTH_DIR=/var/lib/kelescope/auth

# Validité d'un certificat client, en jours.
KELESCOPE_CLIENT_CERT_DAYS=365

# Durée d'une session ouverte, en heures.
KELESCOPE_SESSION_HOURS=12

# Validité d'un code d'invitation, en heures.
KELESCOPE_INVITE_HOURS=24
